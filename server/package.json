{
  "name": "fleet-console-server",
  "version": "0.1.0",
  "description": "Fleet Console API — talks to the Docker Engine and serves fleet state",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^12.11.1",
    "dockerode": "^4.0.2",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
